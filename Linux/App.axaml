<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrameCastStudio.Linux.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1c1f26" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Button.rec">
      <Setter Property="Background" Value="#c0392b" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.live">
      <Setter Property="Background" Value="#7b3fe4" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.big">
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="StackPanel.row">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="10" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="StackPanel.row > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="150" />
    </Style>
  </Application.Styles>
</Application>
